# ==============================================================
# Car2Go Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a Git. Está en .gitignore.
# ==============================================================

# --- Base de datos (Render MySQL) ---
# Render te da esta URL automáticamente cuando creas el MySQL
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Convertida a JDBC:
DATABASE_URL=jdbc:mysql://HOST:3306/car2go?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=car2go_user
DATABASE_PASSWORD=tu_password_seguro

# --- JPA ---
JPA_SHOW_SQL=false
JPA_DDL_AUTO=update

# --- JWT (mínimo 256 bits — genera con: openssl rand -base64 64) ---
JWT_SECRET=genera_con_openssl_rand_base64_64
JWT_EXPIRATION_DAYS=7

# --- CORS (URL de tu Cloudflare Pages) ---
CORS_ALLOWED_ORIGINS=https://car2go.pages.dev

# --- Puerto (Render lo inyecta automáticamente) ---
PORT=8080
